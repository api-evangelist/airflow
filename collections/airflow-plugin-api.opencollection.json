{
  "opencollection": "1.0.0",
  "info": {
    "name": "Airflow Asset Plugin API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "Plugin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Airflow Get Plugins",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v2/plugins",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Airflow Get Plugins"
        },
        {
          "info": {
            "name": "Airflow Import Errors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v2/plugins/importErrors",
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Airflow Import Errors"
        }
      ]
    }
  ],
  "bundled": true
}