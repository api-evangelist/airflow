{
  "opencollection": "1.0.0",
  "info": {
    "name": "Airflow Asset experimental API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "experimental",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Airflow Experimental: Wait for a Dag Run to Complete, and Return Task Results if Requested.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v2/dags/:dag_id/dagRuns/:dag_run_id/wait",
            "params": [
              {
                "name": "dag_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "dag_run_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "interval",
                "value": "",
                "type": "query",
                "description": "Seconds to wait between dag run state checks"
              },
              {
                "name": "result",
                "value": "",
                "type": "query",
                "description": "Collect result XCom from task. Can be set multiple times."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "🚧 This is an experimental endpoint and may change or be removed without notice.Successful response are streamed as newline-delimited JSON (NDJSON). Each line is a JSON object representing the DAG run state."
        }
      ]
    }
  ],
  "bundled": true
}